# Copy to .env and fill only the providers you use. Never commit .env.
# Set CONTEXTTIDE_HOME to this folder when running from another directory or an installed wheel.
# CONTEXTTIDE_HOME=C:\path\to\contexttide
CONTEXTTIDE_DB=.contexttide/contexttide.sqlite3
SLACK_BOT_TOKEN=

# Google: either a short-lived access token, or all three refresh-token values.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Required only for HTTP mode. Use a long random value and HTTPS in front of it.
CONTEXTTIDE_HTTP_TOKEN=

